# 本文件仅是说明，程序从进程环境读取变量；不自动载入 .env。
MODEL_BASE_URL=https://your-provider.example/v1
MODEL_NAME=your-model
MODEL_API_KEY=
# 可选：以下单价和预算必须使用同一货币；不会自动查询供应商价格。
MODEL_INPUT_PRICE_PER_MILLION=
MODEL_OUTPUT_PRICE_PER_MILLION=
MODEL_MAX_COST=
# embedded：API进程带一个后台Worker；external：另运行 python -m procurepilot.worker。
# disabled：禁止后台入队。动态分析可在同一 Worker 中并发调用两个独立角色。
MODEL_WORKER_MODE=embedded
REDIS_URL=
REDIS_STREAM_KEY=procurepilot:analysis:v1
KNOWLEDGE_BACKEND=fixture
NEO4J_HTTP_URL=http://127.0.0.1:57474
NEO4J_DATABASE=neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_GRAPH_SCOPE=procurepilot-fixtures-v1
SEARCH_BACKEND=local
OPENSEARCH_URL=http://127.0.0.1:59200
OPENSEARCH_INDEX=procurepilot-evidence-v1
# 远程检索服务的认证信息仅放进程环境；本机演示不启用远程服务认证。
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
OBJECT_ROOT=
# S3 仅用于新上传；已有对象继续按数据库记录的后端读取。
OBJECT_BACKEND=local
OBJECT_S3_BUCKET=
OBJECT_S3_PREFIX=procurepilot
OBJECT_S3_REGION=us-east-1
# AWS 托管服务留空自定义端点；访问凭据由 SDK 凭据链或工作负载身份提供。
OBJECT_S3_ENDPOINT=
EMBEDDING_CACHE_DIR=
# 可选的本机 INT8 重排模型目录。未设置时使用词法和向量融合结果。
RERANK_MODEL_DIR=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# 可选的 Langfuse OTLP 目的地。实际项目密钥由进程环境或部署 Secret 注入。
LANGFUSE_HOST=
# 直连不稳定时，可为 Langfuse 单独配置 HTTP(S) 代理。
LANGFUSE_PROXY_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
DEMO_MODE=1
# 非演示部署必须设 DEMO_MODE=0 并配置独立密钥及工作区授权。
# API_TOKENS_JSON={"replace-with-secret":{"role":"buyer","workspaces":["workspace-uuid"]}}
